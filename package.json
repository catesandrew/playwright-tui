{
  "name": "playwright-tui",
  "version": "0.1.0",
  "description": "Terminal UI wrapper for Playwright test runner with live stats and interactive controls",
  "type": "module",
  "license": "MIT",
  "author": "Andrew Cates",
  "repository": {
    "type": "git",
    "url": "https://github.com/catesandrew/playwright-tui"
  },
  "bin": {
    "playwright-tui": "bin/playwright-tui",
    "pwtui": "bin/playwright-tui"
  },
  "scripts": {
    "dev": "bun src/cli.tsx",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:exe": "bun build ./src/cli.tsx --compile --outfile ./dist/playwright-tui"
  },
  "dependencies": {
    "ink": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "react-devtools-core": "^4.28.5",
    "typescript": "^5.7.2"
  }
}
